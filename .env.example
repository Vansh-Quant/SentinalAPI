# =============================================================================
# SentinelAPI backend configuration
# Copy to backend/.env and adjust values. NEVER commit the real .env.
# =============================================================================

# --- Security -----------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-string

# Token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ------------------------------------------------------------------
# PostgreSQL (recommended; docker-compose.yml provides it):
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel
# SQLite fallback for quick local runs (no install needed):
# DATABASE_URL=sqlite:///./sentinel.db

# --- Uploads -------------------------------------------------------------------
# Directory where uploaded OpenAPI specifications are stored (relative to backend/)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# --- Scanner sandbox (Phase 2 — scanner worker target) --------------------------
# Only explicitly provisioned/sandboxed API instances are scanned; never arbitrary
# internet hosts.
SANDBOX_BASE_URL=http://localhost:9000
# Optional external scanner service. If unavailable, the deterministic local
# scanner engine is used for the demo.
SCANNER_BASE_URL=http://localhost:9100

# --- App ------------------------------------------------------------------------
ENVIRONMENT=development
# Comma-separated list of allowed CORS origins (dashboard frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
